# Production credentials must not be supplied to preview or local environments.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only allowlist; use a verified owner email.
OWNER_EMAIL=
# Exact canonical app origin, used for OAuth and recovery callbacks.
APP_URL=

# Enable after applying the bookmark migration, provisioning the owner, and verifying restore.
READER_BOOKMARKS_ENABLED=false
READER_POSITIONS_ENABLED=false
READER_ANNOTATIONS_ENABLED=false
READER_PREFERENCES_ENABLED=false

CHECKPOINTS_ENABLED=false
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Enable after applying and verifying the chapter exam simulation migration.
CHAPTER_SIMULATIONS_ENABLED=false
# Defaults to GEMINI_GENERATION_MODEL when unset.
GEMINI_EVALUATION_MODEL=
